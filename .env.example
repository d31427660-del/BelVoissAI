# Voxi.by — Конфигурация окружения

# 1. Supabase (Клиентские публичные ключи — безопасно для браузера при включенном RLS)
# Получить в https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================================================
# СЕРВЕРНЫЕ ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ (ТОЛЬКО для Vercel Functions / Backend)
# НИКОГДА не добавляйте префикс VITE_ к секретным ключам ниже!
# ============================================================================

# 2. Supabase Service Role (для защищенного начисления минут из вебхука bePaid)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Yandex SpeechKit (синтез речи /api/tts — 1 000 000 символов/мес бесплатно)
# Сервисный аккаунт с ролью ai.speechkit-tts.user в https://console.yandex.cloud
YANDEX_API_KEY=AQVN_your_yandex_service_account_api_key
# YANDEX_FOLDER_ID нужен только при использовании IAM-токена вместо API-ключа
YANDEX_FOLDER_ID=

# 4. Платежная система bePaid (ЕРИП и интернет-эквайринг БЕЛКАРТ / Visa / Mastercard в BYN)
# Получить в личном кабинете https://bepaid.by
BEPAID_SHOP_ID=your_bepaid_shop_id
BEPAID_SECRET_KEY=your_bepaid_secret_key
BEPAID_TEST_MODE=true
# Код услуги ЕРИП (для тестового режима bePaid используйте 99999999)
BEPAID_ERIP_SERVICE_NO=99999999

# Публичный URL сайта (для редиректов после оплаты bePaid и вебхуков)
PUBLIC_SITE_URL=https://voxi.by
