# ============================================================================
# Voxi.by — Конфигурация окружения (ISPmanager MySQL / hoster.by + API)
# ============================================================================

# 1. База данных MySQL / MariaDB в ISPmanager (hoster.by -> Базы данных -> Создать)
# Эти переменные можно задать либо в файле .env рядом с сайтом (www/.env),
# либо напрямую в файле www/voxi.by/api/config.php.
# Все 6 таблиц создаются в БД автоматически при первом обращении!
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_ispmanager_db_name
DB_USER=your_ispmanager_db_user
DB_PASS=your_ispmanager_db_password

# 2. Yandex SpeechKit + YandexGPT Lite (/api/tts и /api/chat)
# Сервисный аккаунт в https://console.yandex.cloud с ролями:
# - ai.speechkit-tts.user (1 000 000 символов/мес бесплатно)
# - ai.languageModels.user (живой ИИ-диалог YandexGPT Lite)
YANDEX_API_KEY=AQVN_your_yandex_service_account_api_key
YANDEX_FOLDER_ID=b1g_your_yandex_folder_id

# 3. Платежная система bePaid (ЕРИП и интернет-эквайринг БЕЛКАРТ / Visa / Mastercard в BYN)
# Получить в личном кабинете https://bepaid.by
BEPAID_SHOP_ID=your_bepaid_shop_id
BEPAID_SECRET_KEY=your_bepaid_secret_key
BEPAID_TEST_MODE=true
BEPAID_ERIP_SERVICE_NO=99999999
PUBLIC_SITE_URL=https://voxi.by

# ============================================================================
# (Опционально) Облачный резерв Supabase — требуется только если НЕ используется БД ISPmanager
# ============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
