# Запрет прямого HTTP-доступа к служебным файлам конфигурации и миграциям
<FilesMatch "^(config|bootstrap)\.php$|\.(sql|env|json|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
