# ==============================================================================
# Voxi.by — Root .htaccess для ISPmanager / hoster.by
# Автоматически перенаправляет все запросы в готовую скомпилированную папку /dist/
# Работает из коробки при прямом `git clone` в папку сайта!
# ==============================================================================

AddDefaultCharset UTF-8
DefaultLanguage ru
Options -Indexes

# 1. MIME-типы
<IfModule mod_mime.c>
  AddType text/html .html .htm
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType audio/mpeg .mp3
  AddType audio/wav .wav
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType image/png .png
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# 2. Сжатие Gzip / Deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 3. Заголовки безопасности и доступ к микрофону
<IfModule mod_headers.c>
  Header always set Permissions-Policy "microphone=(self), camera=(), geolocation=()"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: data: https:; connect-src 'self' https://api.vapi.ai wss://*.vapi.ai https://*.bepaid.by; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.bepaid.by; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Неизменяемые скомпилированные ассеты с хешем (JS / CSS) -> кешировать на 1 год
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Статические медиа-файлы (WebP, PNG, SVG, MP3, шрифты) -> кешировать на 30 дней
  <FilesMatch "\.(webp|png|svg|ico|mp3|wav|woff2|woff)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML-страницы и манифест приложения -> не кешировать (всегда свежий SPA вход)
  <FilesMatch "\.(html|htm|webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# 4. Маршрутизация на скомпилированный бандл /dist/
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Проброс заголовка Authorization в PHP LSAPI
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Принудительный HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Запросы к API -> dist/api/<file>.php (или api/<file>.php, если в корне)
  RewriteCond %{DOCUMENT_ROOT}/dist/api/$1.php -f
  RewriteRule ^api/(db|chat|tts|bepaid-checkout|bepaid-webhook|dispatch-webhook|telephony|calendar|vapi-webhook|telegram-webhook)/?$ dist/api/$1.php [QSA,L]

  RewriteCond %{DOCUMENT_ROOT}/api/$1.php -f
  RewriteRule ^api/(db|chat|tts|bepaid-checkout|bepaid-webhook|dispatch-webhook|telephony|calendar|vapi-webhook|telegram-webhook)/?$ api/$1.php [QSA,L]

  # Запрет доступа к служебным файлам исходников (.git, src, node_modules, scripts и секретам)
  RewriteRule ^(\.git|src|node_modules|database|scripts|\.env|\.env\.example|package\.json|package-lock\.json|tsconfig\.json|vite\.config\.ts) - [F,L]

  # Если запрос уже идет к файлу внутри dist/
  RewriteCond %{REQUEST_URI} ^/dist/
  RewriteRule ^ - [L]

  # 1. Если сайт развернут с подпапкой dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
  RewriteRule ^(.*)$ dist/$1/ [L]

  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^$ dist/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ dist/index.html [L]

  # 2. Если сайт развернут напрямую из содержимого dist в корень
  RewriteCond %{DOCUMENT_ROOT}/index.html -f
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
