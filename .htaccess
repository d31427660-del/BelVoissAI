# ==============================================================================
# Voxi.by — Root .htaccess для ISPmanager / hoster.by
# Автоматически перенаправляет все запросы в готовую скомпилированную папку /dist/
# Работает из коробки при прямом `git clone` в папку сайта!
# ==============================================================================

AddDefaultCharset UTF-8
DefaultLanguage ru
Options -Indexes

# 1. MIME-типы
<IfModule mod_mime.c>
  AddType text/html .html .htm
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType audio/mpeg .mp3
  AddType audio/wav .wav
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType image/png .png
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# 2. Сжатие Gzip / Deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 3. Заголовки безопасности и доступ к микрофону
<IfModule mod_headers.c>
  Header always set Permissions-Policy "microphone=(self), camera=(), geolocation=()"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Маршрутизация на скомпилированный бандл /dist/
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Проброс заголовка Authorization в PHP LSAPI
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Принудительный HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Запрет доступа к служебным файлам исходников (.git, src, node_modules)
  RewriteRule ^(\.git|src|node_modules|database|\.env|\.env\.example|package\.json|tsconfig\.json|vite\.config\.ts) - [F,L]

  # Запросы к API -> dist/api/<file>.php
  RewriteRule ^api/(db|chat|tts|bepaid-checkout|bepaid-webhook|dispatch-webhook)/?$ dist/api/$1.php [QSA,L]

  # Если запрос уже идет к файлу внутри dist/
  RewriteCond %{REQUEST_URI} ^/dist/
  RewriteRule ^ - [L]

  # Если запрошенный файл существует внутри dist/ (assets, voices, icon.svg, manifest.webmanifest и др.)
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # Если запрошенная директория существует внутри dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
  RewriteRule ^(.*)$ dist/$1/ [L]

  # Корень сайта -> dist/index.html
  RewriteRule ^$ dist/index.html [L]

  # Все остальные клиентские маршруты SPA -> dist/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ dist/index.html [L]
</IfModule>

<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
