{
  "name": "voxi-by",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "tsc -b && vite build",
    "prerender": "node scripts/prerender.mjs",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "pack:ispmanager": "npm run build && rm -f voxi-ispmanager.zip && (cd dist && zip -r -q ../voxi-ispmanager.zip . -x '*.DS_Store')",
    "preview": "vite preview",
    "test:features": "npx tsx scripts/verify_new_features.ts",
    "test:hydration": "node scripts/test_hydration.mjs",
    "test": "npx tsx scripts/verify_new_features.ts && node scripts/test_hydration.mjs"
  },
  "dependencies": {
    "@oddbird/popover-polyfill": "^0.7.3",
    "@solar-icons/react": "^2.3.3",
    "@supabase/supabase-js": "^2.49.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "lucide-react": "^0.475.0",
    "msedge-tts": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@solar-icons/cli": "^2.7.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
